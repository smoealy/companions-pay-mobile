{
  "expo": {
    "name": "Companions Pay",
    "slug": "companions-pay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.companions.pay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.companions.pay"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "owner": "smoeali",
    "extra": {
      "eas": {
        "projectId": "3b046a82-6d4a-4d2e-9492-0a5a3bc63015"
      }
    },
    "cli": {
      "appVersionSource": "project"
    },
    "sdkVersion": "50.0.0",
    "platforms": ["ios", "android"]
  }
}

